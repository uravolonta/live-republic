{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "owner-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/owner-web"],
      "port": 3000
    },
    {
      "name": "customer-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "apps/customer-web"],
      "port": 3001
    },
    {
      "name": "owner-web-live",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PROXY_TARGET=https://live-republic-server.fly.dev",
        "npm",
        "run",
        "dev",
        "--prefix",
        "apps/owner-web"
      ],
      "port": 3000
    },
    {
      "name": "customer-web-live",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_PROXY_TARGET=https://live-republic-server.fly.dev",
        "npm",
        "run",
        "dev",
        "--prefix",
        "apps/customer-web"
      ],
      "port": 3001
    }
  ]
}
